{
  "name": "bb-plugin-issue-sweep",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "Issue Sweep",
    "description": "Open GitHub issues assigned to you, split into what needs you and everything else grouped by board status, with local notes, an On hold box that sinks an issue to the bottom, new comment counts, and the comments a click away. Clicking the sync time shows what the past hour of sweeps cost against GitHub's rate limit. Needs gh-context.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@danielb/gh-shared": "file:../gh-shared",
    "@hugeicons/core-free-icons": "^4.3.4",
