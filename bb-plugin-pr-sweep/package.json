    "bb-plugin-gh-context": "file:../bb-plugin-gh-context",
    "bb-plugin-harvest": "file:../bb-plugin-harvest",
    "@danielbachhuber/bb-plugin-component-library": "^1.4.0",
    "sweep-ui": "file:../sweep-ui",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.60",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.2.1",
