{
  "name": "@danielbachhuber/bb-plugin-component-library",
  "version": "1.4.0",
  "description": "UI that several plugins draw the same way, starting with the sync status in a page's title bar.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielbachhuber/bb-plugins.git",
    "directory": "component-library"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "*/*.ts",
    "*/*.tsx",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.stories.tsx",
    "README.md"
  ],
  "bb": {
    "pluginTailwindContent": [
      "**/*.tsx",
      "!**/*.test.tsx",
      "!**/*.stories.tsx",
      "!node_modules/**"
    ]
  },
  "type": "module",
  "exports": {
    "./sync-status": "./sync-status/sync-status.tsx",
    "./sidebar-count": "./sidebar-count/sidebar-count.tsx",
    "./segmented": "./segmented/segmented.tsx",
    "./calendar": "./calendar/calendar.tsx",
    "./date-range": "./date-range/date-range.tsx",
    "./day-menu": "./day-menu/day-menu.tsx",
    "./parse-day": "./day-menu/parse-day.ts",
    "./copy-link": "./copy-link/copy-link.ts",
    "./top-bar": "./top-bar/top-bar.tsx",
    "./nav-badge": "./nav-badge/nav-badge.tsx",
    "./start-thread": "./start-thread/start-thread.tsx",
    "./thread-status": "./thread-status/thread-status.tsx",
    "./last-value": "./last-value/last-value.ts"
  },
  "peerDependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0",
    "react-day-picker": "^10.0.2",
    "@get-bb/plugin-sdk": ">=0.4.21",
    "sonner": "^1.7.4 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "react-day-picker": {
      "optional": true
    },
    "@get-bb/plugin-sdk": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "react-day-picker": "^10.0.2",
    "@get-bb/plugin-sdk": "0.4.47",
    "sonner": "^1.7.4"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
